# Public Content Delivery Token — liefert ausschliesslich veroeffentlichte Inhalte.
# Wird in Produktion verwendet.
STORYBLOK_PUBLIC_TOKEN=

# Preview Content Delivery Token — liefert auch Entwuerfe.
# Wird nur unter /preview verwendet und muss NEXT_PUBLIC_ heissen,
# weil die Storyblok Bridge im Browser laeuft.
NEXT_PUBLIC_STORYBLOK_PREVIEW_TOKEN=

# Freies Geheimnis. Muss mit dem Query-Parameter im Storyblok-Webhook uebereinstimmen.
STORYBLOK_WEBHOOK_SECRET=

# Oeffentliche Basis-URL, fuer Metadaten und sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://blokwerk.vercel.app
